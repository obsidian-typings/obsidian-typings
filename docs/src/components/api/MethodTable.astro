---
import { ApiStatus } from './types.ts';
import MemberFilters from './MemberFilters.astro';

interface MethodRow {
  description: string;
  href: string;
  inheritedFrom?: string;
  returns: string;
  signature: string;
  status: ApiStatus;
}

interface Props {
  rows: MethodRow[];
}

const { rows } = Astro.props;
const hasOfficial = rows.some((r) => r.status === ApiStatus.Official);
const hasUnofficial = rows.some((r) => r.status !== ApiStatus.Official);
const hasInherited = rows.some((r) => !!r.inheritedFrom);
---

<h2>Methods</h2>
<MemberFilters group="methods" hasOfficial={hasOfficial} hasUnofficial={hasUnofficial} hasInherited={hasInherited} />
<table>
  <colgroup>
    <col style="width: auto" />
    <col style="width: 20%" />
    <col style="width: 30%" />
    <col style="width: 50%" />
  </colgroup>
  <thead>
    <tr>
      <th style="text-align: center"></th>
      <th style="text-align: left">Method</th>
      <th style="text-align: left">Returns</th>
      <th style="text-align: left">Description</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => {
      const iconClass = row.status === ApiStatus.Official ? 'icon-official' : 'icon-unofficial';
      const title = row.status === ApiStatus.Official
        ? 'Official API — part of the public Obsidian API'
        : 'Unofficial API — reverse-engineered, may change without notice';
      const inherited = row.inheritedFrom
        ? `<br/><em>(Inherited from ${row.inheritedFrom})</em>`
        : '';
      const statusAttr = row.status === ApiStatus.Official ? 'official' : 'unofficial';
      const scopeIcon = row.inheritedFrom ? 'icon-inherited' : 'icon-own';
      const scopeTitle = row.inheritedFrom ? 'Inherited from parent type' : 'Defined on this type';
      return (
        <tr data-status={statusAttr} data-inherited={row.inheritedFrom ? 'true' : 'false'}>
          <td style="text-align: center; white-space: nowrap; width: 1px"><span class={iconClass} title={title}></span><span class={scopeIcon} title={scopeTitle}></span></td>
          <td style="text-align: left"><a href={row.href} set:html={row.signature} /></td>
          <td style="text-align: left" set:html={row.returns} />
          <td style="text-align: left" set:html={row.description + inherited} />
        </tr>
      );
    })}
  </tbody>
</table>
