---
import { ApiStatus } from './types.ts';

interface MethodRow {
  description: string;
  href: string;
  inheritedFrom?: string;
  returns: string;
  signature: string;
  status: ApiStatus;
}

interface Props {
  rows: MethodRow[];
}

const { rows } = Astro.props;
---

<h2>Methods</h2>
<table>
  <colgroup>
    <col style="width: auto" />
    <col style="width: 20%" />
    <col style="width: 30%" />
    <col style="width: 50%" />
  </colgroup>
  <thead>
    <tr>
      <th style="text-align: center"></th>
      <th style="text-align: left">Method</th>
      <th style="text-align: left">Returns</th>
      <th style="text-align: left">Description</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => {
      const iconClass = row.status === ApiStatus.Official ? 'icon-official' : 'icon-unofficial';
      const title = row.status === ApiStatus.Official
        ? 'Official API — part of the public Obsidian API'
        : 'Unofficial API — reverse-engineered, may change without notice';
      const inherited = row.inheritedFrom
        ? `<br/><em>(Inherited from ${row.inheritedFrom})</em>`
        : '';
      return (
        <tr>
          <td style="text-align: center"><span class={iconClass} title={title}></span></td>
          <td style="text-align: left"><a href={row.href} set:html={row.signature} /></td>
          <td style="text-align: left" set:html={row.returns} />
          <td style="text-align: left" set:html={row.description + inherited} />
        </tr>
      );
    })}
  </tbody>
</table>
