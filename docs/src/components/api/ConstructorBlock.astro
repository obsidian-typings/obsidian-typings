---
import { Code } from '@astrojs/starlight/components';

import { ApiStatus } from './types.ts';

interface Props {
  description?: string;
  signature: string;
  status?: ApiStatus;
}

const { signature, description, status } = Astro.props;
const iconClass = status === ApiStatus.Official ? 'icon-official' : 'icon-unofficial';
const title = status === ApiStatus.Official
  ? 'Official API — part of the public Obsidian API'
  : 'Unofficial API — reverse-engineered, may change without notice';
const statusAttr = status === ApiStatus.Official ? 'official' : 'unofficial';
---

<div class="filterable-block" data-status={statusAttr} data-inherited="false">
  <h2><span class={iconClass} title={title}></span><span class="icon-own" title="Defined on this type"></span> Constructor</h2>
  <Code code={signature} lang="ts" />
  {description && <p set:html={description} />}
</div>
