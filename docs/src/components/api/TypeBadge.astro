---
import { ApiStatus } from './types.ts';

interface Props {
  status: ApiStatus;
}

const { status } = Astro.props;
const isOfficial = status === ApiStatus.Official;
const iconClass = isOfficial ? 'icon-official' : 'icon-unofficial';
const title = isOfficial
  ? 'Official API — part of the public Obsidian API'
  : 'Unofficial API — reverse-engineered, may change without notice';
const label = isOfficial ? 'Official' : 'Unofficial';
---

<div class="type-badge-row">
  <span class:list={['status-pill', isOfficial ? 'pill-official' : 'pill-unofficial']} title={title}>
    <span class={iconClass}></span> {label}
  </span>
  <slot />
</div>

<style>
  .type-badge-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    border-radius: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  :global([data-theme='dark']) .pill-official {
    background: rgba(74, 222, 128, 0.2);
    color: #4ade80;
  }
  :global([data-theme='light']) .pill-official {
    background: rgba(22, 163, 74, 0.15);
    color: #15803d;
  }
  :global([data-theme='dark']) .pill-unofficial {
    background: rgba(251, 146, 60, 0.2);
    color: #fb923c;
  }
  :global([data-theme='light']) .pill-unofficial {
    background: rgba(234, 88, 12, 0.15);
    color: #c2410c;
  }
</style>
