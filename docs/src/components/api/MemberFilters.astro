---
/**
 * Page-level filter toggles for all member tables (properties, methods).
 * Segmented toggle buttons: Official/Unofficial/Both, Own/Inherited/Both.
 * Renders once per page and controls all tables with data-status rows.
 */
---

<div class="member-filters">
  <div class="filter-group" data-filter-type="status">
    <button class="filter-btn active" data-value="both">Both</button>
    <button class="filter-btn" data-value="official"><span class="icon-official"></span> Official</button>
    <button class="filter-btn" data-value="unofficial"><span class="icon-unofficial"></span> Unofficial</button>
  </div>
  <div class="filter-group" data-filter-type="scope">
    <button class="filter-btn active" data-value="both">Both</button>
    <button class="filter-btn" data-value="own"><span class="icon-own"></span> Own</button>
    <button class="filter-btn" data-value="inherited"><span class="icon-inherited"></span> Inherited</button>
  </div>
</div>

<script>
  function initFilters(): void {
    const container = document.querySelector<HTMLDivElement>('.member-filters');
    if (!container) {
      return;
    }

    const items = document.querySelectorAll<HTMLElement>('table tbody tr[data-status], .filterable-block[data-status]');

    for (const filterGroup of container.querySelectorAll<HTMLDivElement>('.filter-group')) {
      for (const btn of filterGroup.querySelectorAll<HTMLButtonElement>('.filter-btn')) {
        btn.addEventListener('click', () => {
          for (const sibling of filterGroup.querySelectorAll('.filter-btn')) {
            sibling.classList.remove('active');
          }
          btn.classList.add('active');
          applyFilters(container, items);
        });
      }
    }
  }

  function applyFilters(container: HTMLDivElement, items: NodeListOf<HTMLElement>): void {
    const statusBtn = container.querySelector<HTMLButtonElement>('[data-filter-type="status"] .filter-btn.active');
    const scopeBtn = container.querySelector<HTMLButtonElement>('[data-filter-type="scope"] .filter-btn.active');
    const statusFilter = statusBtn?.dataset['value'] ?? 'both';
    const scopeFilter = scopeBtn?.dataset['value'] ?? 'both';

    for (const item of items) {
      const isOfficial = item.dataset['status'] === 'official';
      const isInherited = item.dataset['inherited'] === 'true';

      let statusVisible = true;
      if (statusFilter === 'official') {
        statusVisible = isOfficial;
      } else if (statusFilter === 'unofficial') {
        statusVisible = !isOfficial;
      }

      let scopeVisible = true;
      if (scopeFilter === 'own') {
        scopeVisible = !isInherited;
      } else if (scopeFilter === 'inherited') {
        scopeVisible = isInherited;
      }

      item.style.display = statusVisible && scopeVisible ? '' : 'none';
    }
  }

  initFilters();
  document.addEventListener('astro:after-swap', initFilters);
</script>

<style>
  .member-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0;
    margin-bottom: 0;
  }
  .filter-group {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    overflow: hidden;
    font-size: 0.8125rem;
  }
  .filter-btn {
    padding: 0.25rem 0.625rem;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    line-height: 1;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: background-color 0.15s, color 0.15s;
  }
  .filter-btn:not(:last-child) {
    border-right: 1px solid var(--sl-color-gray-5);
  }
  .filter-btn:hover:not(.active) {
    background: var(--sl-color-gray-6);
  }
  .filter-btn.active {
    background: var(--sl-color-accent);
    color: white;
  }
  :global([data-theme='dark']) .filter-btn[data-value="official"] {
    background: rgba(74, 222, 128, 0.2);
    color: #4ade80;
  }
  :global([data-theme='dark']) .filter-btn.active[data-value="official"] {
    background: rgba(74, 222, 128, 0.5);
    color: #fff;
  }
  :global([data-theme='light']) .filter-btn[data-value="official"] {
    background: rgba(22, 163, 74, 0.15);
    color: #15803d;
  }
  :global([data-theme='light']) .filter-btn.active[data-value="official"] {
    background: rgba(22, 163, 74, 0.4);
    color: #fff;
  }
  :global([data-theme='dark']) .filter-btn[data-value="unofficial"] {
    background: rgba(251, 146, 60, 0.2);
    color: #fb923c;
  }
  :global([data-theme='dark']) .filter-btn.active[data-value="unofficial"] {
    background: rgba(251, 146, 60, 0.5);
    color: #fff;
  }
  :global([data-theme='light']) .filter-btn[data-value="unofficial"] {
    background: rgba(234, 88, 12, 0.15);
    color: #c2410c;
  }
  :global([data-theme='light']) .filter-btn.active[data-value="unofficial"] {
    background: rgba(234, 88, 12, 0.4);
    color: #fff;
  }
</style>
