---
/**
 * The site navigation, as one standalone document embedded by every page through an iframe
 * (see `src/components/Sidebar.astro`).
 *
 * Why an iframe: the sidebar is byte-identical on every page, and the API tree is ~1,600 entries.
 * Server-rendering it into each of the ~10,700 API pages made the sidebar 99.8% of every page's
 * HTML — 4.5 GB per channel, which overflowed the 1 GB GitHub Pages artifact cap and starved the
 * build runner. Served as its own document the browser fetches it once and caches it.
 *
 * Because the document cannot know which page embeds it, the two things Starlight normally
 * server-renders — current-page highlighting and expanding that page's ancestors — are applied
 * client-side from the parent frame's URL. Open state and scroll position persist in
 * `sessionStorage`; the key is stable precisely because the document never varies.
 */
// eslint-disable-next-line import-x/no-unresolved -- Defined as virtual module.
import { getCollection } from 'astro:content';

import type {
	SidebarTreeGroup,
	SidebarTreeNode
} from '../sidebar-config.ts';

import SidebarTree from '../components/SidebarTree.astro';
import {
	AUTOGENERATED_GROUPS,
	START_HERE_GROUP_LABEL,
	START_HERE_LINKS
} from '../sidebar-config.ts';
import '../../node_modules/@astrojs/starlight/style/props.css';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
	Resolved by Vite at build time, NOT by reading the path at runtime. This module is bundled into
	the SSR output, so anything derived from `import.meta.url` here points at the build output rather
	than the source tree -- which is exactly how the API tree silently vanished from the deployed
	sidebar once (the helper's `existsSync` check quietly returned an empty tree). `scripts/helpers/
	api-sidebar.ts` still reads the file for the Astro config, where it runs in Node and is correct.
*/
const generatedSidebarModules = import.meta.glob('../generated-sidebar.json', {
	eager: true,
	import: 'default'
});

const apiSidebar = Object.values(generatedSidebarModules)[0] as SidebarTreeNode[] | undefined;

if (!apiSidebar?.length) {
	// Failing the build beats shipping a sidebar with no API reference, which is what happened when
	// this was a warning.
	throw new Error(
		'src/generated-sidebar.json is missing or empty, so the sidebar would ship without the API reference. '
			+ 'Run the API docs generator (npm run setup) before building.'
	);
}

const docs = await getCollection('docs');

/**
 * Reproduces Starlight's `autogenerate` for a content directory. None of the pages in these
 * directories set `sidebar.order`, so Starlight sorts them alphabetically by label.
 */
function autogenerate(directory: string): SidebarTreeNode[] {
	return docs
		.filter((entry) => entry.id.startsWith(`${directory}/`) && !entry.data.sidebar.hidden)
		.map((entry) => ({
			label: entry.data.sidebar.label ?? entry.data.title,
			link: `/${entry.id}/`
		}))
		.sort((a, b) => a.label.localeCompare(b.label));
}

const nodes: SidebarTreeNode[] = [
	{ items: START_HERE_LINKS, label: START_HERE_GROUP_LABEL } satisfies SidebarTreeGroup,
	...AUTOGENERATED_GROUPS.map((group): SidebarTreeGroup => ({
		items: autogenerate(group.directory),
		label: group.label
	})),
	...apiSidebar
];
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* Navigation-only document; it has no content of its own to rank. */}
		<meta name="robots" content="noindex" />
		{/* Every link navigates the embedding page, never this frame. */}
		<base target="_parent" />
		<title>Site navigation</title>

		{/*
			Inlined so the frame paints in the right theme immediately. Mirrors the parent's
			`<html data-theme>` (same origin) and follows it live when the theme picker changes,
			falling back to Starlight's own `localStorage` key when read outside a frame.
		*/}
		<script is:inline>
			(() => {
				const storageKey = 'starlight-theme';

				const fromParent = () => {
					try {
						return window.parent !== window
							? window.parent.document.documentElement.dataset.theme
							: undefined;
					} catch {
						return undefined;
					}
				};

				const fromStorage = () => {
					try {
						const stored = localStorage.getItem(storageKey);
						return stored === 'light' || stored === 'dark' ? stored : undefined;
					} catch {
						return undefined;
					}
				};

				const preferred = () =>
					matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

				const apply = () => {
					document.documentElement.dataset.theme = fromParent() ?? fromStorage() ?? preferred();
				};

				apply();

				try {
					if (window.parent !== window) {
						new MutationObserver(apply).observe(window.parent.document.documentElement, {
							attributeFilter: ['data-theme']
						});
					}
				} catch {}

				matchMedia('(prefers-color-scheme: light)').addEventListener('change', apply);
			})();
		</script>
	</head>

	<body>
		<nav aria-label="Site navigation">
			<SidebarTree base={base} nodes={nodes} />
		</nav>

		<script is:inline>
			(() => {
				const storageKey = 'obsidian-typings-sidebar-state';
				const WRITE_DEBOUNCE_IN_MILLISECONDS = 200;

				const groups = [...document.querySelectorAll('details[data-key]')];
				const scroller = document.scrollingElement ?? document.documentElement;

				// Absent when this is the first visit of the session. Distinguishing "no stored state"
				// from "stored state with nothing open" matters: applying the latter's empty set to a
				// first visit would collapse every group the document rendered open.
				const state = (() => {
					try {
						const raw = sessionStorage.getItem(storageKey);
						if (!raw) {
							return undefined;
						}
						const parsed = JSON.parse(raw);
						return {
							open: Array.isArray(parsed.open) ? parsed.open : [],
							scroll: typeof parsed.scroll === 'number' ? parsed.scroll : 0
						};
					} catch {
						return undefined;
					}
				})();

				const writeState = () => {
					try {
						sessionStorage.setItem(
							storageKey,
							JSON.stringify({
								open: groups.filter((group) => group.open).map((group) => group.dataset.key),
								scroll: scroller.scrollTop
							})
						);
					} catch {}
				};

				// Serializing ~140 groups on every scroll event is far too hot to run unthrottled.
				let writeTimer;
				const scheduleWrite = () => {
					clearTimeout(writeTimer);
					writeTimer = setTimeout(writeState, WRITE_DEBOUNCE_IN_MILLISECONDS);
				};

				// Restore the previous session before highlighting, so `scrollIntoView` below measures
				// against the restored position and only moves when the current entry is off-screen.
				if (state) {
					const openKeys = new Set(state.open);
					for (const group of groups) {
						group.open = openKeys.has(group.dataset.key);
					}
					scroller.scrollTop = state.scroll;
				}

				const currentPath = (() => {
					try {
						return window.parent !== window ? window.parent.location.pathname : location.pathname;
					} catch {
						return undefined;
					}
				})();

				if (currentPath) {
					const normalize = (path) => path.replace(/\/+$/, '') || '/';
					const target = [...document.querySelectorAll('a[href]')].find(
						(anchor) => normalize(new URL(anchor.href).pathname) === normalize(currentPath)
					);

					if (target) {
						target.setAttribute('aria-current', 'page');
						for (
							let ancestor = target.closest('details');
							ancestor;
							ancestor = ancestor.parentElement?.closest('details')
						) {
							ancestor.open = true;
						}
						target.scrollIntoView({ block: 'nearest' });
					}
				}

				for (const group of groups) {
					group.addEventListener('toggle', scheduleWrite);
				}
				addEventListener('scroll', scheduleWrite, { passive: true });
				// The frame is torn down on every parent navigation, so flush synchronously here or a
				// debounced write in flight is lost -- which is most of them.
				addEventListener('pagehide', writeState);
			})();
		</script>

		<style is:global>
			html {
				background-color: var(--sl-color-bg-sidebar);
				color-scheme: dark;
			}

			html[data-theme='light'] {
				color-scheme: light;
			}

			body {
				margin: 0;
				padding: 1rem var(--sl-sidebar-pad-x, 1rem);
				background-color: var(--sl-color-bg-sidebar);
				font-family: var(--__sl-font);
				-webkit-font-smoothing: antialiased;
			}
		</style>
	</body>
</html>
