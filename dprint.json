{
  "typescript": {
    "bracePosition": "sameLine",
    "constructSignature.spaceAfterNewKeyword": true,
    "constructorType.spaceAfterNewKeyword": true,
    "exportDeclaration.forceMultiLine": "whenMultiple",
    "functionExpression.spaceAfterFunctionKeyword": true,
    "importDeclaration.forceMultiLine": "whenMultiple",
    "lineWidth": 1000,
    "quoteStyle": "alwaysSingle",
    "trailingCommas": "never"
  },
  "json": {},
  "markdown": {},
  // dprint respects .gitignore by default (--no-gitignore opts out), so dist, docs/.astro and every
  // node_modules need no entry here. Only paths git does NOT ignore belong below.
  "excludes": [
    "**/*-lock.json",
    "**/*.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.3.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}
