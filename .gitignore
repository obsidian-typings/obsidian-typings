node_modules/
dist/
/src/obsidian/implementations/**/*.d.ts
.vscode

index.d.ts
index.ts

/tsconfig.tsbuildinfo
docs/src/content/docs/api/namespaces/**/*

/docs/src/content/docs/api/README.md
/src/full-types.d.ts

# Astro's generated type cache, deliberately untracked since `chore(docs): upgrade to Astro 6 +
# Starlight 0.39` ("Stop tracking docs/.astro/ generated files"). Keep it a whole-directory ignore:
# a narrower entry tracked three of these files once, and because `typeScriptFiles` covers
# `docs/**/*.ts` that put ESLint on machine-written code, which needed an eleven-rule exemption
# block in `scripts/eslint-config.ts` to stay quiet.
/docs/.astro/
/docs/.cache

/workflow-scripts/.env

.claude/settings.local.json

/docs/src/content/docs/api/
tests/bundle-compat/*/package-lock.json

# The bare `index.ts` rule above matches at any depth, so every bundle-compat scenario's entry file
# lands in it by accident. The existing ones are only tracked because they were force-added; without
# this a new scenario is silently never committed, and the gate that restores `tests` from `main`
# then runs without it.
!tests/bundle-compat/*/index.ts

/.env
