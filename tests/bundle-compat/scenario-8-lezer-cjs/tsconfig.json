{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "es2022",
    "types": [],
    "paths": {
      "@codemirror/language": [
        "./node_modules/@codemirror/language/dist/index.d.cts"
      ],
      "@codemirror/search": [
        "./node_modules/@codemirror/search/dist/index.d.cts"
      ],
      "@lezer/common": [
        "./node_modules/@lezer/common/dist/index.d.cts"
      ]
    }
  },
  "include": [
    "*.ts"
  ]
}
